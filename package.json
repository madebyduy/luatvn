{
  "name": "luatvn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm guardrails && pnpm format:check && pnpm lint && pnpm build && pnpm typecheck:tests && pnpm typecheck:web && pnpm test",
    "clean": "tsc -b --clean",
    "dataset": "node tools/dataset-cli.mjs",
    "dev": "pnpm build && node apps/api/dist/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guardrails": "node tools/check-guardrails.mjs",
    "ingest": "node tools/ingest-cli.mjs",
    "lint": "oxlint --deny-warnings .",
    "mcp": "node apps/mcp/dist/main.js",
    "smoke": "pnpm build && node tools/smoke.mjs",
    "start": "node apps/api/dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:web": "tsc -p apps/web/tsconfig.json",
    "web": "pnpm --filter @luatvn/web dev",
    "drill:portability": "node tools/portability-drill.mjs",
    "publish:public": "node tools/publish-public.mjs"
  },
  "devDependencies": {
    "@luatvn/api": "workspace:*",
    "@luatvn/application": "workspace:*",
    "@luatvn/contracts": "workspace:*",
    "@luatvn/domain": "workspace:*",
    "@luatvn/ingest": "workspace:*",
    "@luatvn/manual-dataset": "workspace:*",
    "@luatvn/mcp": "workspace:*",
    "@luatvn/web": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.10.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "@luatvn/pdf-text": "workspace:*"
  }
}
