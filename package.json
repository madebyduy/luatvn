{
  "name": "luatvn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm guardrails && pnpm format:check && pnpm lint && pnpm build && pnpm typecheck:tests && pnpm test",
    "clean": "tsc -b --clean",
    "dataset": "node tools/dataset-cli.mjs",
    "dev": "pnpm build && node apps/api/dist/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guardrails": "node tools/check-guardrails.mjs",
    "ingest": "node tools/ingest-cli.mjs",
    "lint": "oxlint --deny-warnings .",
    "smoke": "pnpm build && node tools/smoke.mjs",
    "start": "node apps/api/dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@luatvn/api": "workspace:*",
    "@luatvn/application": "workspace:*",
    "@luatvn/contracts": "workspace:*",
    "@luatvn/domain": "workspace:*",
    "@luatvn/ingest": "workspace:*",
    "@luatvn/manual-dataset": "workspace:*",
    "@types/node": "24.10.7",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
